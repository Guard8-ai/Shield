      "key_hex": "fffefdfcfbfaf9f8f7f6f5f4f3f2f1f0efeeedecebeae9e8e7e6e5e4e3e2e1e0",
      "expected_plaintext_hex": "000102030405060708090a0b0c0d0e0f",
      "ciphertext_hex": "1301000000000000000000000000b046ac47a56f6b5d33dd98d793ef3b797ed61510e3e508ba602613ded85522f3d6534f029d51eab4ae290e61efc27f71ae8b1ac642c588e1b73ead252116b38cd7a3602a44e6795147",
      "max_age_ms": null,
      "expected_plaintext_utf8": "\u0000\u0001\u0002\u0003\u0004\u0005\u0006\u0007\b\t\n\u000b\f\r\u000e\u000f"
    },
    {
      "id": "v4-v2-005",
      "description": "v4 key-mode: key=0x01..0x20, plaintext=quick encrypt test",
      "format": "v4-key",
      "key_hex": "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20",
      "expected_plaintext_hex": "717569636b20656e63727970742074657374",
      "ciphertext_hex": "130100000000000000000000000063ed16c5e3afd25ee93e2804fa0e1b5ee070e1791dffd555c2f0985fa8b0c7b7562b1ec438755687cb1dbb8de9b266e76222c93730baf9b5065aadaa9f7a044459ccdb270b7a23d1088977",
      "max_age_ms": null,
      "expected_plaintext_utf8": "quick encrypt test"
    }
  ]
}
